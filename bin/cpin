#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const os = require('os');
const { spawnSync, spawn } = require('child_process');

const store = require('../lib/store');
const session = require('../lib/session');
const settings = require('../lib/settings');

const C = {
  reset: '\x1b[0m', dim: '\x1b[2m', bold: '\x1b[1m',
  red: '\x1b[31m', green: '\x1b[32m', yellow: '\x1b[33m',
  cyan: '\x1b[36m', gray: '\x1b[90m',
};
const supportsColor = process.stdout.isTTY && !process.env.NO_COLOR;
const c = (code, s) => supportsColor ? `${code}${s}${C.reset}` : s;

function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const eq = a.indexOf('=');
      if (eq !== -1) { out[a.slice(2, eq)] = a.slice(eq + 1); }
      else if (i + 1 < argv.length && !argv[i + 1].startsWith('--')) { out[a.slice(2)] = argv[++i]; }
      else { out[a.slice(2)] = true; }
    } else {
      out._.push(a);
    }
  }
  return out;
}

function relTime(iso) {
  const diff = (Date.now() - new Date(iso).getTime()) / 1000;
  if (diff < 60) return `${Math.floor(diff)}s ago`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 86400 * 30) return `${Math.floor(diff / 86400)}d ago`;
  return `${Math.floor(diff / 86400 / 30)}mo ago`;
}

function shortenCwd(cwd) {
  const home = os.homedir();
  return cwd.startsWith(home) ? '~' + cwd.slice(home.length) : cwd;
}

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
function assertValidId(id) {
  if (!UUID_RE.test(id)) throw new Error(`Refusing to act on non-UUID session id: ${JSON.stringify(id).slice(0, 80)}`);
}

function sanitize(raw, max = 200) {
  if (typeof raw !== 'string') return null;
  // Same control-char policy as transcript-derived text (C0+C1 incl. newlines):
  // a multi-line note must not be able to spoof extra rows in `cpin list --plain`.
  const cleaned = session.stripControl(raw);
  if (!cleaned) return null;
  return cleaned.slice(0, max);
}
const sanitizeName = sanitize;

function metaLine(p) {
  const touched = session.lastActivity(p);
  const parts = [shortenCwd(p.cwd), 'pinned ' + relTime(p.pinned_at)];
  if (touched) parts.push('last ' + relTime(new Date(touched).toISOString()));
  return parts.join(' · ');
}

function displayName(pin) {
  return session.liveTitle(pin) || pin.name || null;
}

function warnRetentionIfUnsafe() {
  const ret = settings.currentRetentionDays();
  if (typeof ret !== 'number' || ret < 365) {
    console.log(c(C.yellow, `! cleanupPeriodDays is ${ret ?? 'default (30)'} — pinned transcripts may still be deleted.`));
    console.log(c(C.dim, `  Run "cpin doctor --fix" to bump it to ${settings.SAFE_RETENTION_DAYS} days.`));
  }
}

function cmdPin(args) {
  const id = args._[0] || args.session || session.mostRecentSessionId(process.cwd());
  if (!id) {
    console.error(c(C.red, 'No session id given and none could be inferred from cwd.'));
    process.exit(1);
  }
  assertValidId(id);
  const cwd = args.cwd || process.cwd();
  const found = session.findAnySessionFile(id);
  if (!found && !session.sessionExists(cwd, id)) {
    console.error(c(C.yellow, `Warning: no transcript found on disk for ${id}. Pinning anyway.`));
  }
  let explicit = args.name || (typeof args._[1] === 'string' ? args._.slice(1).join(' ') : '');
  if (args['name-from-stdin']) {
    explicit = fs.readFileSync(0, 'utf8');
  }
  const explicitName = sanitizeName(explicit);
  const noteProvided = args.note !== undefined;
  const noteVal = noteProvided ? sanitize(args.note, 1000) : null;
  const resolvedCwd = found?.cwd || cwd;

  const data = store.load();
  const existing = data.pins.find(p => p.id === id);

  if (existing) {
    // Re-pinning must never silently destroy an existing name or note: only touch
    // a field when the user explicitly supplied a new value for it.
    let changed = false;
    if (explicitName && explicitName !== existing.name) { existing.name = explicitName; changed = true; }
    if (noteProvided && noteVal !== existing.note) { existing.note = noteVal; changed = true; }
    if (resolvedCwd && existing.cwd !== resolvedCwd) { existing.cwd = resolvedCwd; } // silent repair
    store.save(data);
    const label = displayName(existing) || id.slice(0, 8);
    if (changed) {
      console.log(c(C.green, '✓') + ` updated ${c(C.bold, label)} ${c(C.gray, '· ' + shortenCwd(existing.cwd))}`);
    } else {
      console.log(c(C.cyan, '↺') + ` already pinned ${c(C.bold, label)} ${c(C.gray, '· ' + shortenCwd(existing.cwd))}`);
    }
    return;
  }

  const fallback = session.readSessionTitle(session.sessionFilePath(resolvedCwd, id));
  const pin = {
    id,
    name: explicitName || sanitizeName(fallback) || null,
    cwd: resolvedCwd,
    note: noteVal,
    pinned_at: new Date().toISOString(),
  };
  data.pins.push(pin);
  store.save(data);
  console.log(c(C.green, '✓') + ` pinned ${c(C.bold, pin.name || id.slice(0, 8))} ${c(C.gray, '· ' + shortenCwd(pin.cwd))}`);
  warnRetentionIfUnsafe();
}

function cmdNote(args) {
  const id = args._[0] || args.session || session.mostRecentSessionId(process.cwd());
  if (!id) { console.error(c(C.red, 'No session id given.')); process.exit(1); }
  assertValidId(id);
  let text = args.text;
  if (args['text-from-stdin']) text = fs.readFileSync(0, 'utf8');
  const clean = sanitize(text, 1000);
  const data = store.load();
  let pin = data.pins.find(p => p.id === id);
  let autoPinned = false;
  if (!pin) {
    // Noting an unpinned session pins it on the spot — a note is worthless if the
    // transcript it points at gets garbage-collected for lack of a pin.
    const found = session.findAnySessionFile(id);
    const resolvedCwd = found?.cwd || process.cwd();
    const fallback = session.readSessionTitle(session.sessionFilePath(resolvedCwd, id));
    pin = {
      id,
      name: sanitizeName(fallback) || null,
      cwd: resolvedCwd,
      note: null,
      pinned_at: new Date().toISOString(),
    };
    data.pins.push(pin);
    autoPinned = true;
  }
  pin.note = clean;
  store.save(data);
  const label = displayName(pin) || id.slice(0, 8);
  if (autoPinned) {
    if (clean) console.log(c(C.green, '✓') + ` pinned & noted ${c(C.bold, label)}: ${c(C.cyan, clean)}`);
    else console.log(c(C.green, '✓') + ` pinned ${c(C.bold, label)}`);
    warnRetentionIfUnsafe();
  } else if (clean) {
    console.log(c(C.green, '✓') + ` note set for ${label}: ${c(C.cyan, clean)}`);
  } else {
    console.log(c(C.green, '✓') + ` note cleared for ${label}`);
  }
}

const DEFAULT_AUTO_SUGGEST = { enabled: true, minMessages: 50, minDurationHours: 4 };

function getAutoSuggestSettings() {
  const data = store.load();
  const a = (data.settings && data.settings.autoSuggest) || {};
  return {
    enabled: a.enabled !== false,
    minMessages: typeof a.minMessages === 'number' ? a.minMessages : DEFAULT_AUTO_SUGGEST.minMessages,
    minDurationHours: typeof a.minDurationHours === 'number' ? a.minDurationHours : DEFAULT_AUTO_SUGGEST.minDurationHours,
  };
}

function formatDuration(ms) {
  const totalMinutes = Math.floor(ms / 60000);
  const hours = Math.floor(totalMinutes / 60);
  const minutes = totalMinutes % 60;
  if (hours >= 1) return minutes ? `${hours}h${minutes}m` : `${hours}h`;
  return `${minutes}m`;
}

function cmdSuggestPin() {
  // Invoked by Claude Code's Stop hook with JSON on stdin.
  // Failure modes are silent: a noisy hook would interrupt every session end.
  let input;
  try {
    const raw = fs.readFileSync(0, 'utf8').trim();
    if (!raw) process.exit(0);
    input = JSON.parse(raw);
  } catch {
    process.exit(0);
  }
  const sessionId = input.session_id || input.sessionId;
  const transcriptPath = input.transcript_path || input.transcriptPath;
  if (!sessionId || !UUID_RE.test(sessionId)) process.exit(0);

  const cfg = getAutoSuggestSettings();
  if (!cfg.enabled) process.exit(0);

  // Already pinned? nothing to suggest.
  const data = store.load();
  if (data.pins.find(p => p.id === sessionId)) process.exit(0);

  let statsPath = transcriptPath;
  if (!statsPath || !fs.existsSync(statsPath)) {
    const found = session.findAnySessionPath(sessionId);
    if (!found) process.exit(0);
    statsPath = found;
  }
  const stats = session.readSessionStats(statsPath);
  if (stats.messageCount < cfg.minMessages) process.exit(0);
  if (stats.durationMs < cfg.minDurationHours * 3600 * 1000) process.exit(0);

  // Print to stderr so Claude Code shows it to the user without polluting transcripts.
  const dur = formatDuration(stats.durationMs);
  process.stderr.write(`\n${c(C.cyan, '› cpin:')} long session (${c(C.bold, stats.messageCount + ' msgs')} over ${c(C.bold, dur)}) — ${c(C.cyan, '/pin')} to keep this thread, or ${c(C.dim, 'cpin config --auto-suggest off')} to silence\n`);
  process.exit(0);
}

function cmdConfig(args) {
  const printCurrent = () => {
    const cfg = getAutoSuggestSettings();
    console.log(c(C.bold, 'claude-pin settings'));
    console.log(`  autoSuggest.enabled:           ${cfg.enabled}`);
    console.log(`  autoSuggest.minMessages:       ${cfg.minMessages}${cfg.minMessages === DEFAULT_AUTO_SUGGEST.minMessages ? c(C.dim, ' (default)') : ''}`);
    console.log(`  autoSuggest.minDurationHours:  ${cfg.minDurationHours}${cfg.minDurationHours === DEFAULT_AUTO_SUGGEST.minDurationHours ? c(C.dim, ' (default)') : ''}`);
  };

  const flagKeys = ['min-messages', 'min-duration-hours', 'auto-suggest', 'reset'];
  const setAnyFlag = flagKeys.some(k => args[k] !== undefined);

  if (!setAnyFlag) {
    printCurrent();
    console.log('');
    console.log(c(C.dim, '  change with:'));
    console.log(c(C.dim, '    cpin config --min-messages 100'));
    console.log(c(C.dim, '    cpin config --min-duration-hours 2'));
    console.log(c(C.dim, '    cpin config --auto-suggest off'));
    console.log(c(C.dim, '    cpin config --reset'));
    return;
  }

  const data = store.load();
  if (args.reset) {
    delete data.settings;
    store.save(data);
    console.log(c(C.green, '✓') + ' settings reset to defaults');
    printCurrent();
    return;
  }
  if (!data.settings) data.settings = {};
  if (!data.settings.autoSuggest) data.settings.autoSuggest = {};
  const a = data.settings.autoSuggest;
  if (args['min-messages'] !== undefined) {
    const n = parseInt(args['min-messages'], 10);
    if (isNaN(n) || n <= 0) { console.error(c(C.red, '--min-messages must be a positive integer')); process.exit(1); }
    a.minMessages = n;
  }
  if (args['min-duration-hours'] !== undefined) {
    const h = parseFloat(args['min-duration-hours']);
    if (isNaN(h) || h <= 0) { console.error(c(C.red, '--min-duration-hours must be a positive number')); process.exit(1); }
    a.minDurationHours = h;
  }
  if (args['auto-suggest'] !== undefined) {
    const v = String(args['auto-suggest']).toLowerCase();
    a.enabled = !(v === 'off' || v === 'false' || v === '0' || v === 'no');
  }
  store.save(data);
  console.log(c(C.green, '✓') + ' settings updated');
  printCurrent();
}

function cmdAdd(args) {
  const limit = parseInt(args.limit, 10) || 50;
  const daysBack = parseInt(args.since, 10) || 365;
  const items = session.listAllRecentSessions({ limit, daysBack });
  if (!items.length) {
    console.log(c(C.gray, 'No recent Claude Code sessions found in ~/.claude/projects/'));
    return;
  }
  const data = store.load();
  const originallyPinned = new Set(data.pins.map(p => p.id));
  if (args.plain || !process.stdout.isTTY) {
    items.forEach(it => {
      const marker = originallyPinned.has(it.id) ? c(C.green, '●') : c(C.dim, '·');
      console.log(`${marker} ${c(C.bold, it.title || '(no title)')} ${c(C.gray, it.id.slice(0, 8))}`);
      console.log(`  ${c(C.dim, shortenCwd(it.cwd) + ' · ' + relTime(new Date(it.mtimeMs).toISOString()))}`);
    });
    return;
  }
  return addTui(items, originallyPinned);
}

function cmdUnpin(args) {
  const id = args._[0] || args.session || session.mostRecentSessionId(process.cwd());
  if (!id) { console.error(c(C.red, 'No session id given.')); process.exit(1); }
  assertValidId(id);
  const removed = store.remove(id);
  if (removed) console.log(c(C.green, '✓') + ` unpinned ${id.slice(0, 8)}`);
  else console.log(c(C.gray, `(no pin found for ${id.slice(0, 8)})`));
}

function plainList(pins) {
  for (const p of pins) {
    const name = displayName(p) || c(C.gray, '(unnamed)');
    const exists = session.sessionExists(p.cwd, p.id) || session.findAnySessionPath(p.id);
    const marker = exists ? c(C.green, '●') : c(C.red, '✗');
    console.log(`${marker} ${c(C.bold, name)} ${c(C.gray, p.id.slice(0, 8))}`);
    console.log(`  ${c(C.dim, metaLine(p))}`);
    if (p.note) console.log(`  ${c(C.cyan, '› ' + p.note)}`);
  }
}

function resumeAndExit(pin) {
  assertValidId(pin.id);
  if (!fs.existsSync(pin.cwd)) {
    // Legacy pins stored a lossily-decoded cwd; recover the real one from the
    // transcript and repair the store so this only ever happens once.
    const found = session.findAnySessionFile(pin.id);
    if (found && found.cwd !== pin.cwd && fs.existsSync(found.cwd)) {
      pin.cwd = found.cwd;
      const data = store.load();
      const stored = data.pins.find(p => p.id === pin.id);
      if (stored) { stored.cwd = found.cwd; store.save(data); }
    }
  }
  if (!fs.existsSync(pin.cwd)) {
    console.error(c(C.yellow, '! cannot resume: original project directory no longer exists'));
    console.error(c(C.dim, `  ${pin.cwd}`));
    console.error('');
    console.error(c(C.dim, '  claude --resume needs the original cwd. options:'));
    console.error(c(C.dim, `    recreate it:  mkdir -p '${pin.cwd}'`));
    console.error(c(C.dim, `    drop pin:     cpin unpin ${pin.id}`));
    process.exit(1);
  }
  const name = displayName(pin) || pin.id.slice(0, 8);
  console.log(c(C.green, '▶') + ` resuming ${c(C.bold, name)} ${c(C.gray, 'in ' + shortenCwd(pin.cwd))}`);
  const child = spawn('claude', ['--resume', pin.id], { cwd: pin.cwd, stdio: 'inherit' });
  child.on('exit', code => process.exit(code ?? 0));
}

function fzfInteractive(pins) {
  const lines = pins.map(p => {
    const info = session.readSessionInfo(session.sessionFilePath(p.cwd, p.id));
    const name = info.customTitle || info.aiTitle || p.name || '(unnamed)';
    const clean = s => (s || '').replace(/[\t\n\r]/g, ' ');
    // Column 6 (note + chat content) is searched by fzf but hidden from display
    // via --with-nth, so a query can hit the conversation, not just the title.
    const hidden = clean([p.note || '', info.searchText || ''].join(' '));
    return [p.id, clean(name), shortenCwd(p.cwd), relTime(p.pinned_at), clean(info.searchText).slice(0, 80), hidden].join('\t');
  });
  const res = spawnSync('fzf', [
    '--with-nth=2,3,4,5',
    '--delimiter=\t',
    '--prompt=pinned ▸ ',
    '--header=enter: resume  ·  ctrl-d: unpin  ·  esc: quit',
    '--expect=ctrl-d',
    '--height=40%',
    '--reverse',
  ], { input: lines.join('\n'), stdio: ['pipe', 'pipe', 'inherit'], encoding: 'utf8' });
  if (res.status === 130 || !res.stdout) return;
  const [pressed, selected] = res.stdout.split('\n');
  if (!selected) return;
  const id = selected.split('\t')[0];
  const pin = pins.find(p => p.id === id);
  if (!pin) return;
  if (pressed === 'ctrl-d') {
    store.remove(pin.id);
    console.log(c(C.green, '✓') + ` unpinned ${displayName(pin) || pin.id.slice(0, 8)}`);
    const remaining = store.list();
    if (remaining.length) return fzfInteractive(remaining.sort((a, b) => new Date(b.pinned_at) - new Date(a.pinned_at)));
    return;
  }
  resumeAndExit(pin);
}

// Precompute everything render()/search touch on disk (title, existence, meta line,
// searchable text) ONCE per pin. Previously each of these hit the filesystem on every
// keypress for every visible row — the source of the picker's lag. The transcript
// content is folded into the search haystack so search reaches into the chat itself,
// not just the title/note.
function enrichPin(p) {
  const sfp = session.sessionFilePath(p.cwd, p.id);
  const info = session.readSessionInfo(sfp);
  const name = info.customTitle || info.aiTitle || p.name || null;
  const exists = fs.existsSync(sfp) || !!session.findAnySessionPath(p.id);
  return {
    ...p,
    _name: name,
    _exists: exists,
    _meta: metaLine(p),
    _preview: (info.searchText || '').slice(0, 100).trim(),
    _search: [name || '', p.note || '', p.cwd || '', info.searchText || ''].join(' ').toLowerCase(),
  };
}

function nodeTui(initialPins) {
  return new Promise((resolve) => {
    let pins = initialPins.map(enrichPin);
    let cursor = -1;
    let inSearch = false;
    let query = '';
    let cleaned = false;
    let scrollTop = 0;
    let lastUnpinned = null; // { pin, index } — most recent unpin, restorable with `u`

    const enterScreen = () => process.stdout.write('\x1b[?1049h\x1b[?25l');
    const exitScreen = () => process.stdout.write('\x1b[?25h\x1b[?1049l');
    const truncate = (s, n) => (s.length > n ? s.slice(0, Math.max(1, n - 1)) + '…' : s);

    const getVisible = () => {
      if (!query) return pins;
      // All terms must match (AND), each anywhere in the haystack — lets you narrow
      // with a few remembered words ("stripe capture mobile") across title/note/content.
      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      return pins.filter(p => terms.every(t => p._search.includes(t)));
    };

    const render = () => {
      const visible = getVisible();
      const rows = process.stdout.rows || 24;
      const cols = process.stdout.columns || 80;

      // Master-detail: every pin is one compact line; only the focused row expands
      // (cwd + note + preview). Keeps a big pin list scannable instead of a wall of text.
      // Collapsed rows are 1 line; the focused row adds up to 3 — reserve slack for that.
      const vp = Math.max(3, rows - 8);
      if (cursor === -1) scrollTop = 0;
      else {
        if (cursor < scrollTop) scrollTop = cursor;
        if (cursor >= scrollTop + vp) scrollTop = cursor - vp + 1;
      }
      scrollTop = Math.min(scrollTop, Math.max(0, visible.length - vp));
      const end = Math.min(visible.length, scrollTop + vp);

      // Hint legend: keys pop in cyan, labels stay default-color (readable),
      // only the `·` separators are dim. The `ctrl-u undo` slot is dim until an
      // undo is available — then the key lights yellow.
      const k = (s) => c(C.cyan, s);
      const sep = c(C.dim, ' · ');
      let segments;
      if (inSearch) {
        segments = [`type to filter`, `${k('↑/↓')} move`, `${k('enter')} resume`, `${k('esc')} clear`];
      } else {
        segments = [`${k('↑/↓')} navigate`, `${k('enter')} resume`, `${k('/')} search`, `${k('ctrl-d')} unpin`, `${k('q')} quit`];
      }
      let hintLine = segments.join(sep);
      if (!inSearch) {
        const undoSeg = lastUnpinned ? `${c(C.yellow, 'ctrl-u')} undo` : c(C.dim, 'ctrl-u undo');
        hintLine += sep + undoSeg;
      }

      let out = '\x1b[H';
      let header = c(C.bold, 'claude-pin') + '   ' + hintLine;
      if (visible.length > vp) header += c(C.dim, `   ${scrollTop + 1}–${end} of ${visible.length}`);
      out += header + '\x1b[K\n';
      if (inSearch || query) {
        const caret = inSearch ? c(C.cyan, '▏') : '';
        out += c(C.dim, '  search: ') + query + caret + '\x1b[K\n';
      }
      out += '\x1b[K\n';

      if (!visible.length) {
        const empty = query ? '  (no matches)' : (lastUnpinned ? '  (no pins — press ctrl-u to undo)' : '  (no pins left)');
        out += c(C.gray, empty) + '\x1b[K\n';
      } else {
        for (let i = scrollTop; i < end; i++) {
          const p = visible[i];
          const focused = i === cursor;
          // No arrow — the dot IS the focus marker. Green ● on the focused row,
          // dim · elsewhere. Red ✗ overrides on any row when the transcript is gone
          // (health beats focus).
          let dot;
          if (!p._exists) dot = c(C.red, '✗');
          else if (focused) dot = c(C.green, '●');
          else dot = c(C.dim, '·');
          const nameStr = truncate(p._name || '(unnamed)', 50);
          const name = focused ? c(C.bold, nameStr) : nameStr;
          const noteMark = p.note ? c(C.cyan, ' ✎') : '';
          out += `${dot} ${name}${noteMark}  ${c(C.gray, '· ' + relTime(p.pinned_at))}  ${c(C.gray, p.id.slice(0, 8))}\x1b[K\n`;
          if (focused) {
            out += `   ${c(C.dim, p._meta)}\x1b[K\n`;
            if (p.note) out += `   ${c(C.cyan, truncate('› ' + p.note, cols - 5))}\x1b[K\n`;
            if (p._preview) out += `   ${c(C.gray, truncate('“' + p._preview + '”', cols - 5))}\x1b[K\n`;
          }
        }
      }
      out += '\x1b[J';
      process.stdout.write(out);
    };

    const cleanup = () => {
      if (cleaned) return;
      cleaned = true;
      if (process.stdin.isTTY) process.stdin.setRawMode(false);
      process.stdin.pause();
      process.stdin.removeListener('data', onKey);
      exitScreen();
    };
    process.on('exit', cleanup);
    process.on('SIGINT', () => { cleanup(); process.exit(130); });
    process.on('SIGTERM', () => { cleanup(); process.exit(143); });

    const doUnpin = () => {
      const visible = getVisible();
      if (cursor === -1 || !visible[cursor]) return;
      const target = visible[cursor];
      const index = pins.findIndex(p => p.id === target.id);
      store.remove(target.id);
      lastUnpinned = { pin: target, index };
      pins = pins.filter(p => p.id !== target.id);
      const newVisible = getVisible();
      if (!pins.length) { render(); return; } // keep the picker open so ctrl-u can undo the last one
      if (!newVisible.length) cursor = -1;
      else if (cursor >= newVisible.length) cursor = newVisible.length - 1;
      render();
    };
    const doUndo = () => {
      if (!lastUnpinned) return;
      const { pin, index } = lastUnpinned;
      // Re-persist (strip the cached _-prefixed display fields) and restore in place.
      const data = store.load();
      if (!data.pins.some(p => p.id === pin.id)) {
        const { _name, _exists, _meta, _preview, _search, ...bare } = pin;
        data.pins.push(bare);
        store.save(data);
      }
      const at = Math.min(Math.max(index, 0), pins.length);
      pins.splice(at, 0, pin);
      lastUnpinned = null;
      const visibleNow = getVisible();
      cursor = visibleNow.findIndex(p => p.id === pin.id);
      if (cursor === -1) cursor = 0;
      render();
    };

    const onKey = (chunk) => {
      const k = chunk.toString();
      if (k === '\x03') { cleanup(); resolve(); return; }
      if (k === '\x04') { doUnpin(); return; } // ctrl-d: unpin (works while searching too)
      if (k === '\x15') { doUndo(); return; }  // ctrl-u: undo (works while searching too)

      if (inSearch) {
        if (k === '\x1b') { query = ''; inSearch = false; cursor = -1; render(); return; }
        // Arrow keys move focus through the filtered list without leaving search —
        // type to narrow, then arrow straight down to the row you want.
        if (k === '\x1b[A' || k === '\x1bOA') {
          const v = getVisible();
          if (v.length) cursor = cursor === -1 ? v.length - 1 : Math.max(0, cursor - 1);
          render(); return;
        }
        if (k === '\x1b[B' || k === '\x1bOB') {
          const v = getVisible();
          if (v.length) cursor = cursor === -1 ? 0 : Math.min(v.length - 1, cursor + 1);
          render(); return;
        }
        if (k === '\r' || k === '\n') {
          // Resume from inside search — no need to exit search first. Picks the
          // focused row, or the top of the filtered list if the user typed and
          // hit enter without arrowing (the common "narrow then go" case).
          const v = getVisible();
          if (!v.length) { inSearch = false; render(); return; }
          const target = cursor !== -1 ? v[cursor] : v[0];
          if (!target) { inSearch = false; render(); return; }
          cleanup();
          process.stdout.write('\n');
          resumeAndExit(target);
          return;
        }
        if (k === '\x7f' || k === '\x08') { query = query.slice(0, -1); cursor = -1; render(); return; }
        // Don't let an arrow's "[A"/"OB" tail leak into the query as literal chars.
        if (/^[\x20-\x7e]+$/.test(k) && !k.startsWith('\x1b')) { query += k; cursor = -1; render(); return; }
        return;
      }

      if (k === 'q' || k === '\x1b') { cleanup(); resolve(); return; }
      if (k === '/') { inSearch = true; render(); return; }

      const visible = getVisible();
      if (k === '\x1b[A' || k === '\x1bOA' || k === 'k') {
        if (!visible.length) return;
        cursor = cursor === -1 ? visible.length - 1 : Math.max(0, cursor - 1);
        render(); return;
      }
      if (k === '\x1b[B' || k === '\x1bOB' || k === 'j') {
        if (!visible.length) return;
        cursor = cursor === -1 ? 0 : Math.min(visible.length - 1, cursor + 1);
        render(); return;
      }
      if (k === '\r' || k === '\n') {
        // Resume the focused row directly — no two-stage select.
        if (cursor === -1 || !visible[cursor]) return;
        cleanup();
        process.stdout.write('\n');
        resumeAndExit(visible[cursor]);
        return;
      }
      if (k === 'd' || k === 'x') { doUnpin(); return; }
      if (k === 'u') { doUndo(); return; }
    };

    if (process.stdin.isTTY) process.stdin.setRawMode(true);
    process.stdin.resume();
    process.stdin.on('data', onKey);
    enterScreen();
    render();
  });
}

function addTui(items, originallyPinned) {
  return new Promise((resolve) => {
    let cursor = -1;
    const toggled = new Set();
    let cleaned = false;
    let scrollTop = 0;

    const enterScreen = () => process.stdout.write('\x1b[?1049h\x1b[?25l');
    const exitScreen = () => process.stdout.write('\x1b[?25h\x1b[?1049l');

    const finalPinned = (id) => {
      const orig = originallyPinned.has(id);
      return toggled.has(id) ? !orig : orig;
    };

    const viewportSize = () => {
      const rows = process.stdout.rows || 24;
      return Math.max(4, Math.floor((rows - 4) / 2));
    };

    const render = () => {
      const vp = viewportSize();
      if (cursor !== -1) {
        if (cursor < scrollTop) scrollTop = cursor;
        if (cursor >= scrollTop + vp) scrollTop = cursor - vp + 1;
      }
      const end = Math.min(items.length, scrollTop + vp);
      const pendingPin = [...toggled].filter(id => !originallyPinned.has(id)).length;
      const pendingUnpin = [...toggled].filter(id => originallyPinned.has(id)).length;
      let out = '\x1b[H';
      let header = c(C.bold, 'claude-pin · add');
      if (pendingPin || pendingUnpin) {
        const parts = [];
        if (pendingPin) parts.push(`+${pendingPin}`);
        if (pendingUnpin) parts.push(`-${pendingUnpin}`);
        header += c(C.yellow, '   ' + parts.join(' '));
      }
      header += c(C.dim, `   showing ${scrollTop + 1}–${end} of ${items.length}`);
      out += header + '\x1b[K\n';
      out += c(C.dim, '  ↑/↓ navigate · space: toggle · enter: apply · esc/q: cancel') + '\x1b[K\n';
      out += '\x1b[K\n';
      for (let i = scrollTop; i < end; i++) {
        const it = items[i];
        const focused = i === cursor;
        const pinned = finalPinned(it.id);
        const prefix = focused ? c(C.cyan, '▸ ') : '  ';
        const dot = pinned ? c(C.green, '●') : c(C.dim, '·');
        const rawTitle = it.title || c(C.gray, '(no title)');
        const title = focused ? c(C.bold, rawTitle) : rawTitle;
        const idStr = c(C.gray, it.id.slice(0, 8));
        const meta = c(C.dim, shortenCwd(it.cwd) + ' · ' + relTime(new Date(it.mtimeMs).toISOString()));
        out += `${prefix}${dot} ${title} ${idStr}\x1b[K\n    ${meta}\x1b[K\n`;
      }
      out += '\x1b[J';
      process.stdout.write(out);
    };

    const cleanup = () => {
      if (cleaned) return;
      cleaned = true;
      if (process.stdin.isTTY) process.stdin.setRawMode(false);
      process.stdin.pause();
      process.stdin.removeListener('data', onKey);
      exitScreen();
    };
    process.on('exit', cleanup);
    process.on('SIGINT', () => { cleanup(); process.exit(130); });

    const onKey = (chunk) => {
      const k = chunk.toString();
      if (k === '\x03' || k === 'q' || k === '\x1b') {
        cleanup();
        if (toggled.size) console.log(c(C.gray, `cancelled (${toggled.size} pending change${toggled.size === 1 ? '' : 's'} discarded)`));
        resolve(); return;
      }
      if (k === '\x1b[A' || k === '\x1bOA' || k === 'k') {
        cursor = cursor === -1 ? items.length - 1 : Math.max(0, cursor - 1);
        render(); return;
      }
      if (k === '\x1b[B' || k === '\x1bOB' || k === 'j') {
        cursor = cursor === -1 ? 0 : Math.min(items.length - 1, cursor + 1);
        render(); return;
      }
      if (k === ' ' && cursor !== -1) {
        const id = items[cursor].id;
        if (toggled.has(id)) toggled.delete(id); else toggled.add(id);
        render(); return;
      }
      if (k === '\r' || k === '\n') {
        cleanup();
        if (!toggled.size) { console.log(c(C.gray, 'no changes')); resolve(); return; }
        const data = store.load();
        let pinned = 0, unpinned = 0;
        for (const id of toggled) {
          const it = items.find(x => x.id === id);
          if (!it) continue;
          if (originallyPinned.has(id)) {
            data.pins = data.pins.filter(p => p.id !== id);
            unpinned++;
          } else {
            data.pins.push({
              id: it.id,
              name: sanitize(it.title) || null,
              cwd: it.cwd,
              note: null,
              pinned_at: new Date().toISOString(),
            });
            pinned++;
          }
        }
        store.save(data);
        if (pinned) console.log(c(C.green, '✓') + ` pinned ${pinned} session${pinned === 1 ? '' : 's'}`);
        if (unpinned) console.log(c(C.green, '✓') + ` unpinned ${unpinned} session${unpinned === 1 ? '' : 's'}`);
        resolve();
      }
    };

    if (process.stdin.isTTY) process.stdin.setRawMode(true);
    process.stdin.resume();
    process.stdin.on('data', onKey);
    enterScreen();
    render();
  });
}

function cmdList(args) {
  const pins = store.list();
  if (!pins.length) {
    console.log(c(C.gray, 'No pinned sessions yet. Use /pin inside a session, or `cpin pin <id>`.'));
    return;
  }
  pins.sort((a, b) => new Date(b.pinned_at) - new Date(a.pinned_at));
  if (args.plain || !process.stdout.isTTY) return plainList(pins);
  if (fzfAvailable()) return fzfInteractive(pins);
  return nodeTui(pins);
}

function fzfAvailable() {
  const r = spawnSync('which', ['fzf'], { stdio: 'ignore' });
  return r.status === 0;
}

function cmdPick(args) {
  return cmdList(args);
}

function cmdPrune() {
  const data = store.load();
  const kept = [];
  const dropped = [];
  for (const p of data.pins) {
    if (session.sessionExists(p.cwd, p.id) || session.findAnySessionPath(p.id)) kept.push(p);
    else dropped.push(p);
  }
  data.pins = kept;
  store.save(data);
  if (!dropped.length) console.log(c(C.gray, 'Nothing to prune.'));
  else {
    console.log(c(C.yellow, `Pruned ${dropped.length} pin(s) with missing transcripts:`));
    dropped.forEach(p => console.log(`  - ${p.name || '(unnamed)'} ${c(C.gray, p.id.slice(0, 8))}`));
  }
}

function cmdExport(args) {
  const data = store.load();
  const json = JSON.stringify(data, null, 2) + '\n';
  if (args.out) {
    fs.writeFileSync(args.out, json);
    console.log(c(C.green, '✓') + ` exported ${data.pins.length} pin(s) to ${args.out}`);
  } else {
    process.stdout.write(json);
  }
}

function cmdImport(args) {
  const file = args._[0] || args.file;
  if (!file) { console.error(c(C.red, 'Usage: cpin import <file> [--replace]')); process.exit(1); }
  let incoming;
  try {
    incoming = JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (err) {
    console.error(c(C.red, `Cannot read/parse ${file}: ${err.message}`));
    process.exit(1);
  }
  const incomingPins = Array.isArray(incoming) ? incoming : incoming && incoming.pins;
  if (!Array.isArray(incomingPins)) {
    console.error(c(C.red, 'Not a valid export: expected a pins array or { pins: [...] }.'));
    process.exit(1);
  }
  const data = store.load();
  if (args.replace) data.pins = [];
  const seen = new Set(data.pins.map(p => p.id));
  let added = 0, skipped = 0, invalid = 0;
  for (const p of incomingPins) {
    if (!p || !UUID_RE.test(p.id || '')) { invalid++; continue; }
    if (seen.has(p.id)) { skipped++; continue; }
    data.pins.push({
      id: p.id,
      name: sanitizeName(p.name) || null,
      cwd: typeof p.cwd === 'string' ? p.cwd : null,
      note: sanitize(p.note, 1000),
      pinned_at: typeof p.pinned_at === 'string' ? p.pinned_at : new Date().toISOString(),
    });
    seen.add(p.id);
    added++;
  }
  store.save(data);
  console.log(c(C.green, '✓') + ` imported ${added} pin(s)` +
    (skipped ? c(C.gray, `, ${skipped} already present`) : '') +
    (invalid ? c(C.yellow, `, ${invalid} skipped (bad id)`) : ''));
  // cwd + transcripts are machine-specific — flag that imported pins may not resume here.
  if (added) console.log(c(C.dim, '  Note: pins resume only on a machine that has the matching transcripts. Run `cpin prune` to drop dead ones.'));
}

const SKILL_NAMES = ['pin', 'unpin', 'pins', 'note'];

function repoRoot() {
  return path.resolve(fs.realpathSync(__filename), '..', '..');
}

function cmdInstall(args) {
  const repo = repoRoot();
  const dir = path.join(os.homedir(), '.claude', 'skills');
  fs.mkdirSync(dir, { recursive: true });

  let conflicts = 0;
  for (const n of SKILL_NAMES) {
    const src = path.join(repo, 'skills', n);
    const dst = path.join(dir, n);
    if (fs.existsSync(dst)) {
      const isLink = fs.lstatSync(dst).isSymbolicLink();
      const linksHere = isLink && fs.readlinkSync(dst) === src;
      if (linksHere) { console.log(`  ${c(C.gray, '·')} /${n}  ${c(C.gray, '→ already linked')}`); continue; }
      if (!args.force) {
        console.log(`  ${c(C.red, '✗')} /${n}  ${c(C.red, '(exists, use --force to replace)')}`);
        conflicts++;
        continue;
      }
      fs.rmSync(dst, { recursive: true, force: true });
    }
    fs.symlinkSync(src, dst, 'dir');
    console.log(`  ${c(C.green, '✓')} /${n}  ${c(C.gray, '→ ' + dst.replace(os.homedir(), '~'))}`);
  }

  const which = spawnSync('which', ['cpin'], { encoding: 'utf8' });
  console.log('');
  if (which.status === 0) {
    console.log(c(C.green, '✓') + ' cpin on PATH: ' + which.stdout.trim());
  } else {
    console.log(c(C.yellow, '!') + ' cpin is not on your shell PATH yet — the slash commands need it.');
    console.log(c(C.bold, `    cd ${repo} && npm link`));
  }

  const ret = settings.currentRetentionDays();
  if (typeof ret !== 'number' || ret < 365) {
    console.log(c(C.yellow, '!') + ' cleanupPeriodDays is at default (30) — transcripts will be deleted.');
    console.log(c(C.bold, '    cpin doctor --fix'));
  }

  // Stop hook for auto-suggest. Off by default for plain `cpin install`; opt in
  // with --with-auto-suggest, opt out of installed hook with --no-auto-suggest.
  if (args['no-auto-suggest']) {
    const r = settings.removeStopHook();
    if (r.removed) console.log(c(C.gray, '·') + ' Stop hook removed');
  } else if (args['with-auto-suggest']) {
    const r = settings.installStopHook('cpin suggest-pin');
    if (r.installed) console.log(c(C.green, '✓') + ' Stop hook installed — long sessions will be flagged on end');
    else console.log(c(C.gray, '·') + ' Stop hook already present');
    console.log(c(C.dim, '    tune with: cpin config --min-messages N --min-duration-hours H'));
  } else {
    console.log(c(C.dim, '  optional: pass --with-auto-suggest to install the Stop hook that nudges you'));
    console.log(c(C.dim, '            to pin sessions longer than 4h with 50+ messages'));
  }

  if (conflicts) process.exit(1);
  console.log(c(C.dim, '\n  Open any Claude Code session and try /pin'));
}

function cmdUninstall() {
  const dir = path.join(os.homedir(), '.claude', 'skills');
  for (const n of SKILL_NAMES) {
    const dst = path.join(dir, n);
    if (!fs.existsSync(dst)) { console.log(`  ${c(C.gray, '·')} /${n}  (not present)`); continue; }
    if (fs.lstatSync(dst).isSymbolicLink()) {
      fs.unlinkSync(dst);
      console.log(`  ${c(C.green, '✓')} /${n}  (symlink removed)`);
    } else {
      console.log(`  ${c(C.yellow, '!')} /${n}  (not a symlink — not removing)`);
    }
  }
  const r = settings.removeStopHook();
  if (r.removed) console.log(`  ${c(C.green, '✓')} Stop hook removed (${r.removed} entr${r.removed === 1 ? 'y' : 'ies'})`);
}

function semverGreater(a, b) {
  const pa = a.split('.').map(n => parseInt(n, 10) || 0);
  const pb = b.split('.').map(n => parseInt(n, 10) || 0);
  for (let i = 0; i < 3; i++) {
    if ((pa[i] || 0) > (pb[i] || 0)) return true;
    if ((pa[i] || 0) < (pb[i] || 0)) return false;
  }
  return false;
}

function cmdUpdate(args) {
  const pkgPath = path.join(repoRoot(), 'package.json');
  const current = JSON.parse(fs.readFileSync(pkgPath, 'utf8')).version;
  console.log(c(C.dim, 'checking npm...'));
  const view = spawnSync('npm', ['view', 'claude-pin', 'version'], { encoding: 'utf8' });
  if (view.status !== 0) {
    console.error(c(C.red, 'failed to check npm: ') + (view.stderr || view.stdout).trim());
    process.exit(1);
  }
  const latest = view.stdout.trim();
  console.log(`  current: ${c(C.bold, current)}`);
  console.log(`  latest:  ${c(C.bold, latest)}`);
  if (current === latest) {
    console.log(c(C.green, '\n✓ already on the latest version'));
    return;
  }
  if (semverGreater(current, latest)) {
    console.log(c(C.green, `\n✓ you're ahead of npm (local ${current} > registry ${latest}) — looks like a dev build`));
    return;
  }
  console.log(c(C.yellow, `\n! update available: ${current} → ${latest}`));
  if (args.check) {
    console.log(c(C.dim, '  run "cpin update" to install'));
    return;
  }
  let isDev = false;
  try {
    const npmRoot = spawnSync('npm', ['root', '-g'], { encoding: 'utf8' }).stdout.trim();
    const installPath = path.dirname(path.dirname(fs.realpathSync(__filename)));
    isDev = !installPath.startsWith(npmRoot);
    if (isDev) {
      console.log(c(C.yellow, '\n! you appear to be on a dev install (npm link)'));
      console.log(c(C.dim, `  binary resolves to: ${installPath}`));
      console.log(c(C.dim, '  to update the published copy:  npm install -g claude-pin@latest'));
      console.log(c(C.dim, `  to update your dev copy:        cd ${shortenCwd(installPath)} && git pull`));
      return;
    }
  } catch { /* fall through and try the install */ }
  console.log(c(C.cyan, `\n▶ installing claude-pin@${latest}...`));
  const install = spawn('npm', ['install', '-g', `claude-pin@${latest}`], { stdio: 'inherit' });
  install.on('exit', code => {
    if (code === 0) console.log(c(C.green, `\n✓ updated to ${latest} — next \`cpin\` invocation uses the new version`));
    process.exit(code ?? 0);
  });
}

function cmdDoctor(args) {
  console.log(c(C.bold, 'claude-pin doctor'));
  console.log(`  store: ${store.storePath()}`);
  console.log(`  pins:  ${store.list().length}`);
  const ret = settings.currentRetentionDays();
  console.log(`  cleanupPeriodDays: ${ret ?? c(C.yellow, 'default (30)')}`);
  if (typeof ret === 'number' && ret >= 365) {
    console.log(c(C.green, '  ✓ transcripts will survive long enough for pinning to be useful.'));
    return;
  }
  if (args.fix || args.yes) {
    const r = settings.ensureSafeRetention();
    console.log(c(C.green, `  ✓ set cleanupPeriodDays to ${r.current} (was ${r.previous ?? 'default'}).`));
    return;
  }
  console.log(c(C.yellow, `  ! transcripts are deleted after ${ret ?? 30} days. Pinned sessions can vanish.`));
  console.log(c(C.dim, `    Run "cpin doctor --fix" to set cleanupPeriodDays to ${settings.SAFE_RETENTION_DAYS}.`));
}

function help() {
  console.log(`${c(C.bold, 'cpin')} — pin Claude Code sessions so they survive the resume window.

${c(C.bold, 'Setup:')}
  cpin install [--force]     Symlink /pin /unpin /pins /note into ~/.claude/skills
                             Pass --with-auto-suggest to also install the Stop hook
  cpin uninstall             Remove the symlinks and the Stop hook
  cpin doctor [--fix]        Check setup; --fix bumps cleanupPeriodDays
  cpin update [--check]      Update to the latest claude-pin from npm

${c(C.bold, 'Usage:')}
  cpin                       Interactive picker (↑↓ · enter resume · ctrl-d unpin · ctrl-u undo · q quit)
  cpin list                  Same as above; --plain for static output
  cpin pin [id] --name X     Pin a session (defaults to most recent in cwd)
  cpin unpin [id]            Unpin (defaults to most recent in cwd)
  cpin add                   Pin/unpin from a picker of recent sessions across all projects
  cpin note <id> --text X    Set/clear a free-text note on a pin
  cpin prune                 Drop pins whose transcript is gone
  cpin export [--out FILE]   Print/write the pin store (backup)
  cpin import FILE [--replace] Merge pins from a backup (--replace overwrites)
  cpin update [--check]      Update claude-pin from npm
  cpin config [flags]        View/change settings (auto-suggest thresholds)
  cpin help                  This message
`);
}

const cmds = {
  install: cmdInstall, uninstall: cmdUninstall,
  pin: cmdPin, 'pin-current': cmdPin,
  unpin: cmdUnpin, 'unpin-current': cmdUnpin,
  add: cmdAdd, discover: cmdAdd,
  note: cmdNote,
  list: cmdList, ls: cmdList,
  pick: cmdPick, resume: cmdPick,
  prune: cmdPrune,
  export: cmdExport, import: cmdImport,
  update: cmdUpdate, upgrade: cmdUpdate,
  config: cmdConfig,
  'suggest-pin': cmdSuggestPin,
  doctor: cmdDoctor,
  help, '--help': help, '-h': help,
};

const [, , cmd, ...rest] = process.argv;
const argv = parseArgs(rest);
try {
  if (!cmd) {
    cmdList(parseArgs([]));
  } else {
    const handler = cmds[cmd];
    if (!handler) {
      console.error(c(C.red, `Unknown command: ${cmd}`));
      help();
      process.exit(1);
    }
    handler(argv);
  }
} catch (err) {
  console.error(c(C.red, 'Error: ') + err.message);
  process.exit(1);
}
